# .env.production.example
# Configuração de PRODUÇÃO para o Habblet Mine
# NUNCA commite o arquivo .env real com estas chaves.

# --- GLOBAL ---
APP_ENV=production
APP_BASE_URL=https://mine.habblet.com.br
LOG_LEVEL=info
SUPPORT_EMAIL=contato@habblet.com.br

# --- MERCADO PAGO (OBRIGATÓRIO) ---
# Use credenciais de produção (começam com APP_USR-)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-XXXX-XXXX
MERCADOPAGO_WEBHOOK_SECRET=CHAVE_WEBHOOK_PROD

# --- PLUGIN MINECRAFT (OBRIGATÓRIO) ---
PLUGIN_ID=habblet-prime
PLUGIN_SECRET_CURRENT=CHAVE_HMAC_PROD_LONGA_E_SEGURA
PLUGIN_SECRET_PREVIOUS=

# --- FEATURE FLAGS ---
MAINTENANCE_MODE=false
REAL_PAYMENTS_ENABLED=true
FORCE_BRANDED_EMAIL=true
