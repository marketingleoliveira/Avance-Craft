# .env.staging.example
# Configuração de STAGING para o Habblet Mine

# --- GLOBAL ---
APP_ENV=staging
APP_BASE_URL=https://staging-mine.habblet.com.br
LOG_LEVEL=info

# --- MERCADO PAGO (SANDBOX) ---
# Use credenciais de teste (começam com TEST-)
MERCADOPAGO_ACCESS_TOKEN=TEST-XXXX-XXXX
MERCADOPAGO_WEBHOOK_SECRET=CHAVE_WEBHOOK_STAGING

# --- PLUGIN MINECRAFT ---
PLUGIN_ID=habblet-staging
PLUGIN_SECRET_CURRENT=chave-staging-hmac
PLUGIN_SECRET_PREVIOUS=

# --- FEATURE FLAGS ---
MAINTENANCE_MODE=false
REAL_PAYMENTS_ENABLED=false
