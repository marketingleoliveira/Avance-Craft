# .env.example
# Configuração de Ambiente para o Habblet Mine
# Copie este arquivo para .env e preencha os valores conforme necessário.

# --- GLOBAL ---
APP_ENV=development
APP_BASE_URL=http://localhost:8080
LOG_LEVEL=debug
SUPPORT_EMAIL=suporte@habblet.com.br

# --- MERCADO PAGO (OPCIONAL EM DEV) ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- PLUGIN MINECRAFT (OPCIONAL EM DEV) ---
PLUGIN_ID=servidor-dev
PLUGIN_SECRET_CURRENT=chave-dev-local
PLUGIN_SECRET_PREVIOUS=

# --- FEATURE FLAGS ---
MAINTENANCE_MODE=false
REAL_PAYMENTS_ENABLED=false
